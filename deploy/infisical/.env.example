# Copy these keys into Coolify > service > Environment Variables.
# Never commit real values.

# 32 hex chars:   openssl rand -hex 16
# Losing or changing it makes stored secrets unreadable: back it up offline.
ENCRYPTION_KEY=

# Base64 secret:  openssl rand -base64 32
AUTH_SECRET=

# Database password:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Public HTTPS URL assigned to the service in Coolify, no trailing slash
SITE_URL=https://infisical.example.com
